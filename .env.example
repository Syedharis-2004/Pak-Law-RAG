# ============================================================
# PakLaw AI — Environment Variables Template
# Copy to .env and fill in your values
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_NAME=PakLaw AI
APP_VERSION=1.0.0
APP_SECRET_KEY=change-me-to-a-very-long-random-string-at-least-64-chars
DEBUG=true

# ── Backend Server ────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_RELOAD=true

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=PakLaw AI
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXTAUTH_SECRET=change-me-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# ── PostgreSQL & Database ─────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=paklawai
POSTGRES_USER=paklawai
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=sqlite+aiosqlite:///./paklawai_local.db
SYNC_DATABASE_URL=sqlite:///./paklawai_local.db

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=paklawai
USE_MONGODB=true

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Qdrant ────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_HTTPS=false

# ── Google Gemini ─────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=8192
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40

# ── BGE Embedding & Reranker ──────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_TOP_K=10

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-key-at-least-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# ── File Storage ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,html,md

# ── PaddleOCR ─────────────────────────────────────────────────
OCR_LANG=en
OCR_USE_GPU=false
OCR_ENABLE_MKLDNN=false

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_REQUESTS=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60

# ── Chunking ──────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_CHUNKS_PER_DOCUMENT=5000

# ── Retrieval ─────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANKER_FINAL_TOP_K=5
HYBRID_SEARCH_ALPHA=0.7
CONTEXT_COMPRESSION_RATIO=0.5

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/paklawai.log

# ── Observability ─────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ── Email (optional) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@paklawai.com
